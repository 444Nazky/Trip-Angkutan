# Server API INTRANET (port 3000) — melayani seluruh aplikasi dari jaringan
# lokal kantor. Database: PostgreSQL lokal lewat container `rest` (PostgREST).
# Berkas: direktori lokal /data/storage.
#
# Build : sudo docker build -f Dockerfile.backend -t trip-angkutan-api .
# Run   : sudo docker compose up -d api-intranet
#
# Env dibaca dari server/api/.env.local (lihat .env.example).
# File .env.local SENGAJA tidak ikut ke dalam image (lihat .dockerignore) —
# env disuntikkan saat runtime lewat `env_file` di docker-compose.yml.
FROM denoland/deno:alpine-2.9.8

WORKDIR /srv/api

ENV PORT=3000 \
    HOST=0.0.0.0 \
    DENO_NO_UPDATE_CHECK=1 \
    DENO_DIR=/deno-dir

COPY server/api/ ./api/

# Cache dependency saat build: std/path dari deno.land + npm:bcryptjs.
# Setelah ini server start TANPA perlu internet (cache sudah baked ke image).
#
# PENTING: `deno cache` TIDAK menerima flag izin (--allow-net dkk). Kalau diberi,
# perintah gagal dan cache tetap kosong -> server baru bisa start setelah
# mengunduh dependency dari internet saat runtime.
#
# --node-modules-dir=none: memaksa Deno memakai cache globalnya sendiri.
# Tanpa flag ini Deno mencari package.json di folder induk dan mencoba
# menyelesaikan `npm:bcryptjs@2.4.3` dari node_modules repo (yang berisi
# bcryptjs ^3) -> server gagal start.
RUN deno cache --node-modules-dir=none api/local_server.ts

# Jalankan sebagai user non-root.
RUN mkdir -p /deno-dir && chown -R deno:deno /deno-dir /srv/api
USER deno

EXPOSE 3000

# --allow-net   : serve request lokal + fetch ke PostgREST (http://rest:3000)
# --allow-env   : baca POSTGREST_URL / STORAGE_DIR / JWT_SECRET / dll
# --allow-read  : baca file handler + berkas di STORAGE_DIR
# --allow-write : tulis berkas (foto trip, APK, bundel OTA) ke STORAGE_DIR
# --allow-sys  : Deno.networkInterfaces() untuk mencetak IP LAN di banner.
#                TANPA flag ini fungsi itu melempar "Requires sys access" dan
#                daftar IP LAN selalu kosong (tanpa error yang mencolok).
CMD ["deno", "run", "--allow-net", "--allow-env", "--allow-read", "--allow-write", "--allow-sys", "--node-modules-dir=none", "api/local_server.ts"]
