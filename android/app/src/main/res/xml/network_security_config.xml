<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
        Kebijakan cleartext (SESI 2026-10-15 — perubahan sadar, tercatat di audit):

        Dulu base-config cleartextTrafficPermitted="false" + pengecualian hanya
        localhost/10.0.2.2/127.0.0.1. Akibatnya server kantor di LAN
        (http://192.168.x.x:3000) SELALU gagal dalam hitungan milidetik dan
        dilaporkan sebagai "Server tidak merespon (8 ms)... URL lama tetap dipakai"
        — petugas tidak bisa memindahkan endpoint dari Railway ke PC kantor.

        Android tidak mendukung rentang IP/CIDR pada elemen <domain>, jadi tidak
        mungkin mengizinkan 192.168.0.0/16 secara selektif di sini. Karena itu
        cleartext diizinkan di level platform, TETAPI kebijakan https-only untuk
        host publik tetap ditegakkan di kode aplikasi:
          - src/services/api.ts → normalizeUrl() memaksa https untuk host publik
            (host privat/LAN dibiarkan http)
          - src/services/api.ts → validateEndpointInput() menolak http:// dari
            halaman https yang dibuka di BROWSER (mixed content), TETAPI
            membolehkannya di aplikasi native (WebView) dan ke loopback
          - src/services/api.ts → isPrivateHostUrl() menandai LAN/privat sebagai
            host yang boleh memakai http://

        Sisa permukaan: aplikasi/webview yang dikompromisen masih bisa membuka
        http:// ke host publik. Mitigasi terjadwal: tinjau ulang saat server kantor
        sudah memakai TLS (cloudflared tunnel) → kembalikan ke "false".
    -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!--
        Server INTRANET kantor (port 3000) - ditegaskan eksplisit supaya jelas
        bahwa cleartext diizinkan untuk alamat ini. Kalau server kantor sudah
        memakai TLS, blokir ini bisa dihapus.
    -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">192.168.1.123</domain>
    </domain-config>
</network-security-config>
