/**
 * Tab "Master Tarif" di admin dashboard — tampilan dua tabel gaya
 * spreadsheet (BADAU | REGION) setara Gambar Tablesheet.
 *
 *   BADAU -> master tarif yang dipakai aplikasi untuk menghitung tagihan
 *            trip (tabel `tariffs`: muatan + kosong per golongan kendaraan)
 *   REGION-> tarif lokal per wilayah (tabel `region_tariffs`: nomal flat)
 *
 * SEMUA angka diambil dari server (tarif trip yang asli). Tidak ada
 * nominal hardcoded; nilai yang tampil adalah nilai resolver tarif di
 * backend (handlers/tariffRules.ts -> resolveTariff):
 *
 *   1. Kategori Internal -> Rp 0 (sel kolom "internal" terkunci)
 *   2. Master tarif      -> kolom "external": muatan / kosong per golongan
 *   3. Tarif region      -> kolom "lokal" (nominal flat per wilayah)
 *
 * Cara edit seperti spreadsheet: klik angka di sel -> ubah -> Enter/blur.
 * Tidak ada tombol simpan; setiap sel autosave ke server saat commit.
 */

import { useCallback, useEffect, useMemo, useRef, useState } from 'react'
import { Plus, Trash2, X } from 'lucide-react'
import type { TariffRow } from '../components/types'
import {
  createTariff,
  deleteTariff,
  fetchRegionTariffs,
  fetchTariffs,
  updateTariff,
  upsertRegionTariff,
} from '../../../services/tariffs'
import { fetchRegions, type Region } from '../../../services/regions'

interface TariffTabProps {
  tariffs: TariffRow[]
  serverState: 'connecting' | 'online' | 'offline'
  onSaveTariffs: (t: TariffRow[]) => void
  showToast: (msg: string, type?: 'success' | 'error') => void
}

interface AddGolongan {
  golongan: string
  type: string
  muatan: string
  kosong: string
}

const GOLONGAN_OPTIONS = ['I', 'II', 'III', 'IV', 'V']

/** Urutan baris mengikuti sketsa spreadsheet: motor .. truk besar. */
const TYPE_ORDER = ['motor', 'mobil', 'truk kecil', 'truk sedang', 'truk besar']

const normalizeType = (t: string) =>
  String(t ?? '')
    .trim()
    .toLowerCase()
    .replace(/truck/g, 'truk')

const typeOrderIndex = (t: string) => {
  const i = TYPE_ORDER.indexOf(normalizeType(t))
  return i === -1 ? TYPE_ORDER.length : i
}

const fmtRp = (n: number) => `Rp ${Number(n || 0).toLocaleString('id-ID')}`
const fmtNum = (n: number) => Number(n || 0).toLocaleString('id-ID')

const CONSUME = (row: TariffRow, v: number) => Promise.resolve(!!row)

/** Sel angka gaya spreadsheet: klik -> edit -> Enter/blur autosave. */
function SheetCell({
  value,
  onCommit,
  title = '',
}: {
  value: number
  onCommit: (n: number) => Promise<boolean>
  title?: string
}) {
  const [editing, setEditing] = useState(false)
  const [draft, setDraft] = useState(String(value))
  const [pending, setPending] = useState(false)
  const inputRef = useRef<HTMLInputElement>(null)
  const skipCommit = useRef(false)

  useEffect(() => {
    if (editing) {
      const el = inputRef.current
      el?.focus()
      el?.select()
    }
  }, [editing])

  const commit = async () => {
    setEditing(false)
    const cleaned = draft.replace(/[^\d]/g, '')
    if (!cleaned) return
    const n = Number(cleaned)
    if (!Number.isFinite(n) || n === value) return
    setPending(true)
    try {
      await onCommit(n)
    } finally {
      setPending(false)
    }
  }

  return (
    <td
      title={title}
      onClick={() => !editing && !pending && setEditing(true)}
      className={`border border-slate-300 px-2 py-1 text-right text-[13px] tabular-nums ${
        editing
          ? 'ring-2 ring-blue-300 focus-within:ring-blue-300'
          : 'cursor-cell hover:bg-amber-50/80'
      } ${pending ? 'animate-pulse text-slate-400' : 'text-slate-700'}`}
    >
      {editing ? (
        <input
          ref={inputRef}
          value={draft}
          inputMode="numeric"
          onChange={(e) => setDraft(e.target.value)}
          onKeyDown={(e) => {
            if (e.key === 'Enter') {
              e.preventDefault()
              void commit()
            } else if (e.key === 'Escape') {
              skipCommit.current = true
              setEditing(false)
            }
          }}
          onBlur={() => {
            if (skipCommit.current) {
              skipCommit.current = false
              return
            }
            void commit()
          }}
          className="w-full min-w-0 bg-transparent text-right text-[13px] font-medium outline-none"
        />
      ) : (
        <span className="block">{fmtNum(value)}</span>
      )}
    </td>
  )
}

/** Sel placeholder teks (panel REGION: "tarif muatan" / "tarif kosong"). */
function PlaceholderCell({ label, ref }: { label: string; ref?: string }) {
  return (
    <td
      title={ref}
      className="border border-slate-300 px-2 py-1 text-center text-[11px] italic text-slate-400 select-none"
    >
      {label}
    </td>
  )
}

/** Sel kolom "internal": terkunci (kendaraan internal selalu Rp 0). */
function LockedInternalCell() {
  return (
    <td
      title="Kendaraan internal tidak ditagih (Rp 0)"
      className="border border-slate-300 bg-slate-200/70 px-2 py-1 select-none cursor-not-allowed"
    >
      <span className="block text-center text-[12px] text-slate-400">–</span>
    </td>
  )
}

interface SheetProps {
  title: string
  titleExtra?: React.ReactNode
  rows: TariffRow[]
  /** Panel REGION: kolom external menampilkan placeholder foto, bukan angka. */
  placeholdersExternal?: boolean
  getLokal: (row: TariffRow) => number
  commitLokal: (row: TariffRow, v: number) => Promise<boolean>
  commitMuatan: (row: TariffRow, v: number) => Promise<boolean>
  commitKosong: (row: TariffRow, v: number) => Promise<boolean>
  onDelete: (row: TariffRow) => void
  footer?: React.ReactNode
}

function GolonganSheet({
  title,
  titleExtra,
  rows,
  placeholdersExternal,
  getLokal,
  commitLokal,
  commitMuatan,
  commitKosong,
  onDelete,
  footer,
}: SheetProps) {
  const headerCls =
    'border border-slate-300 bg-slate-50/80 px-2 py-1 text-center text-[12px] font-semibold text-slate-600'

  return (
    <div className="flex-1 min-w-[440px] rounded-xl border border-slate-200 bg-white shadow-sm overflow-hidden">
      <table className="w-full border-collapse text-[13px]">
        <thead>
          <tr>
            <th colSpan={5} className="border border-slate-300 px-2 py-2.5">
              <div className="flex items-center justify-between gap-3 px-2">
                <span className="text-[15px] font-bold tracking-[0.08em] text-slate-800">{title}</span>
                {titleExtra}
              </div>
            </th>
          </tr>
          <tr>
            <th colSpan={5} className="border border-slate-300 px-2 py-1.5 text-center text-[12px] font-bold tracking-wide text-slate-700">
              GOLONGAN
            </th>
          </tr>
          <tr>
            <th rowSpan={2} className={`${headerCls} text-left`}>Jenis</th>
            <th rowSpan={2} className={headerCls}>internal</th>
            <th rowSpan={2} className={headerCls}>lokal</th>
            <th colSpan={2} className={headerCls}>external</th>
          </tr>
          <tr>
            <th className={`${headerCls} text-[11px] font-medium`}>muatan</th>
            <th className={`${headerCls} text-[11px] font-medium`}>kosong</th>
          </tr>
        </thead>
        <tbody>
          {rows.map((row) => (
            <tr key={row.id ?? normalizeType(row.type) + row.golongan} className="group">
              <td className="border border-slate-300 px-2 py-1">
                <div className="flex items-center justify-between gap-1">
                  <span className="text-slate-800">{row.type}</span>
                  <button
                    onClick={() => onDelete(row)}
                    title="Hapus baris ini"
                    className="rounded p-0.5 text-slate-300 opacity-0 transition group-hover:opacity-100 hover:bg-red-50 hover:text-red-600"
                  >
                    <Trash2 size={12} />
                  </button>
                </div>
              </td>
              <LockedInternalCell />
              <SheetCell value={getLokal(row)} onCommit={(v) => commitLokal(row, v)} />
              {placeholdersExternal ? (
                <>
                  <PlaceholderCell label="tarif muatan" ref="Mengacu kolom muatan pada tabel BADAU (tarif trip asli)" />
                  <PlaceholderCell label="tarif kosong" ref="Mengacu kolom kosong pada tabel BADAU (tarif trip asli)" />
                </>
              ) : (
                <>
                  <SheetCell
                    value={row.loadedNum}
                    onCommit={(v) => commitMuatan(row, v)}
                    title="Tarif trip asli: kartu muatan"
                  />
                  <SheetCell
                    value={row.emptyNum}
                    onCommit={(v) => commitKosong(row, v)}
                    title="Tarif trip asli: kartu kosong"
                  />
                </>
              )}
            </tr>
          ))}
        </tbody>
        {footer}
      </table>
    </div>
  )
}

export function TariffTab({ tariffs, serverState, onSaveTariffs, showToast }: TariffTabProps) {
  const [regions, setRegions] = useState<Region[]>([])
  const [regionTariffs, setRegionTariffs] = useState<Record<string, { lokal: number; aktif: boolean }>>({})
  const [panelRegionId, setPanelRegionId] = useState('')
  const [addOpen, setAddOpen] = useState(false)
  const [addForm, setAddForm] = useState<AddGolongan>({ golongan: '', type: '', muatan: '', kosong: '' })
  const [saving, setSaving] = useState(false)

  // Muat region + tarif wilayah lokal sekali saat tab dibuka.
  useEffect(() => {
    let alive = true
    ;(async () => {
      const [rts, regs] = await Promise.all([fetchRegionTariffs(), fetchRegions()])
      if (!alive) return
      if (regs) setRegions(regs)
      if (rts) {
        const map: Record<string, { lokal: number; aktif: boolean }> = {}
        for (const rt of rts) {
          map[rt.id] = {
            lokal: rt.lokal_tariff ?? 0,
            aktif: (rt.lokal_active ?? 0) === 1,
          }
        }
        setRegionTariffs(map)
      }
    })()
    return () => { alive = false }
  }, [])

  /** Region BADAU (tabel kiri): tarif wilayah Badau. */
  const badauRegion = useMemo(
    () => regions.find((r) => String(r.code ?? '').toUpperCase() === 'BADAU') ?? regions[0] ?? null,
    [regions],
  )

  /** Region panel kanan: default = region pertama selain BADAU. */
  const panelRegion = useMemo(
    () => regions.find((r) => r.id === panelRegionId) ?? regions.find((r) => r.id !== badauRegion?.id) ?? regions[0] ?? null,
    [regions, panelRegionId, badauRegion],
  )

  /** Baris master diurut sesuai urutan sketsa: motor .. truk besar. */
  const sortedRows = useMemo(
    () =>
      [...tariffs].sort(
        (a, b) =>
          typeOrderIndex(a.type) - typeOrderIndex(b.type) ||
          normalizeType(a.type).localeCompare(normalizeType(b.type)) ||
          String(a.golongan).localeCompare(b.golongan),
      ),
    [tariffs],
  )

  const getLokal = useCallback(
    (row: TariffRow) => {
      if (!row.id) return 0
      const reg = panelRegion ?? badauRegion
      ...
    },
    [regionTariffs, ...same arg],
  )

  // + Aksi commit -> autosave =================================================================

  const patchLocal = async () => {
    const fresh = await fetchTariffs()
    if (fresh) onSaveTariffs(fresh)
    else showToast('Gagal memuat ulang tarif', 'error')
  }

  /** Simpan nominal lokal (tarif wilayah) untuk sel "lokal". */
  const commitLokal = async (row: TariffRow, v: number): Promise<boolean> => {
    const reg = panelRegion ?? badauRegion
    if (!reg) {
      showToast('Region belum tersedia', 'error')
      return false
    }
    setSaving(true)
    try {
      const src = regionTariffs[reg.id]
      const ok = await upsertRegionTariff({
        regionId: reg.id,
        tariffType: 'lokal',
        nominal: v,
        aktif: src ? src.aktif || v > 0 : true, // baris baru langsung aktif
      })
      if (!ok) {
        showToast('Server menolak tarif wilayah', 'error')
        return false
      }
      const fresh = await fetchRegionTariffs()
      if (fresh) {
        const map: Record<string, { lokal: number; aktif: boolean }> = {}
        for (const rt of fresh) {
          map[rt.id] = { lokal: rt.lokal_tariff ?? 0, aktif: (rt.lokal_active ?? 0) === 1 }
        }
        setRegionTariffs(map)
      }
      return true
    } finally {
      setSaving(false)
    }
  }

  /** Simpan master tarif (muatan / kosong) per baris golongan. */
  const commitMaster = async (row: TariffRow, field: 'loadedNum' | 'emptyNum', v: number): Promise<boolean> => {
    if (!row.id) return false
    setSaving(true)
    try {
      const updated: TariffRow =
        field === 'loadedNum'
          ? { ...row, loadedNum: v, loaded: fmtRp(v) }
          : { ...row, emptyNum: v, empty: fmtRp(v) }
      const ok = await updateTariff(updated)
      if (!ok) {
        showToast('Server menolak perubahan tarif', 'error')
        return false
      }
      await patchLocal()
      return true
    } finally {
      setSaving(false)
    }
  }

  const commitMuatan = useCallback(
    (row: TariffRow, v: number) => commitMaster(row, 'loadedNum', v),
    [],
  )
  const commitKosong = useCallback(
    (row: TariffRow, v: number) => commitMaster(row, 'emptyNum', v),
    [],
  )

  const handleDelete = async (row: TariffRow) => {
    if (!row.id) return showToast('Baris belum tersimpan di server', 'error')
    if (!confirm(`Hapus baris gonongan ${row.golongan || ''} - ${row.type}?`)) return
    setSaving(true)
    try {
      const ok = await deleteTariff(row)
      if (!ok) return showToast('Server gagal menghapus tarif', 'error')
      const fresh = await fetchTariffs()
      if (fresh) onSaveTariffs(fresh)
      showToast('Baris tarif dihapus')
    } finally {
      setSaving(false)
    }
  }

  /** Golongan default untuk baris baru: yang belum terpakai. */
  const nextGolongan = () => {
    const used = new Set(tariffs.map((t) => String(t.golongan ?? '').toUpperCase()))
    return GOLONGAN_OPTIONS.find((g) => !used.has(g)) ?? 'I'
  }

  const submitAdd = async () => {
    const type = addForm.type.trim()
    const golongan = addForm.golongan.trim().toUpperCase() || nextGolongan()
    const muatan = Number(addForm.muatan.replace(/[^\d]/g, '')) || 0
    const kosong = Number(addForm.kosong.replace(/[^\d]/g, '')) || 0
    if (!type) {
      showToast('Jenis kendaraan wajib diisi', 'error')
      return
    }
    setSaving(true)
    try {
      const id = await createTariff({
        golongan,
        type,
        loaded: fmtRp(muatan),
        loadedNum: muatan,
        empty: fmtRp(kosong),
        emptyNum: kosong,
        desc: '',
      })
      if (!id) return showToast('Server menolak tarif baru', 'error')
      const fresh = await fetchTariffs()
      if (fresh) onSaveTariffs(fresh)
      setAddOpen(false)
      setAddForm({ golongan: '', type: '', muatan: '', kosong: '' })
      showToast('Baris golongan ditambahkan')
    } finally {
      setSaving(false)
    }
  }

  const borderCls = 'border border-slate-300'

  return (
    <div className="space-y-5">
      {/* Header halaman */}
      <div className="flex flex-wrap items-start justify-between gap-4">
        <div>
          <h3 className="font-black text-slate-900 text-lg">Master Tarif</h3>
          <p className="text-slate-500 text-[12px] mt-0.5 max-w-2xl">
            Tarif trip yang asli dipakai aplikasi. Edit seperti spreadsheet:
            klik angka, ubah, lalu Enter — otomatis tersimpan.
          </p>
        </div>
        <span
          className={`inline-flex items-center gap-1.5 text-[11px] font-bold px-3 py-1.5 rounded-full ${
            serverState === 'online'
              ? 'bg-emerald-50 text-emerald-600'
              : serverState === 'offline'
                ? 'bg-red-50 text-red-600'
                : 'bg-amber-50 text-amber-600'
          }`}
        >
          <span
            className={`w-1.5 h-1.5 rounded-full ${
              serverState === 'online' ? 'bg-emerald-500' : serverState === 'offline' ? 'bg-red-500' : 'bg-amber-500'
            }`}
          />
          Server: {serverState === 'online' ? 'Tersambung' : serverState === 'offline' ? 'Offline' : 'Menghubungkan'}
        </span>
      </div>

      {/* Dua tabel spreadsheet berdampingan: BADAU | REGION */}
      <div className="flex flex-wrap items-start gap-6">
        <GolonganSheet
          title="BADAU"
          titleExtra={
            <button
              onClick={() => setAddOpen((v) => !v)}
              title="Tambah baris golongan"
              disabled={saving}
              className="rounded-md p-1 text-slate-400 transition hover:bg-slate-100 hover:text-slate-700 disabled:opacity-40"
            >
              {addOpen ? <X size={14} /> : <Plus size={14} />}
            </button>
          }
          rows={sortedRows}
          placeholdersExternal={false}
          getLokal={(row) => {
            const reg = badauRegion
            if (!reg) return 0
            return regionTariffs[reg.id]?.lokal ?? 0
          }}
          commitLokal={(row, v) => commitLokalForRow(badauRegion, row, v)}
          commitMuatan={commitMuatan}
          commitKosong={commitKosong}
          onDelete={handleDelete}
          footer={
            addOpen ? (
              <tfoot>
                <tr className="bg-amber-50/60">
                  <td className={`${borderCls} px-2 py-1.5`}>
                    <div className="flex items-center gap-1">
                      <input
                        list="tariff-golongan-options"
                        value={addForm.golongan}
                        placeholder={nextGolongan()}
                        onChange={(e) => setAddForm((f) => ({ ...f, golongan: e.target.value }))}
                        onKeyDown={(e) => e.key === 'Enter' && void submitAdd()}
                        className="w-10 border border-slate-200 rounded px-1 py-1 text-center text-[12px] uppercase outline-none focus:border-blue-400"
                      />
                      <input
                        value={addForm.type}
                        placeholder="jenis kendaraan"
                        onChange={(e) => setAddForm((f) => ({ ...f, type: e.target.value }))}
                        onKeyDown={(e) => e.key === 'Enter' && void submitAdd()}
                        className="flex-1 min-w-0 border border-slate-200 rounded px-2 py-1 text-[12px] outline-none focus:border-blue-400"
                        autoFocus
                      />
                      <button
                        onClick={() => setAddOpen(false)}
                        title="Batal"
                        className="rounded p-0.5 text-slate-400 hover:bg-slate-200 hover:text-slate-700"
                      >
                        <X size={14} />
                      </button>
                    </div>
                  </td>
                  <LockedInternalCell />
                  <td className={`${borderCls} bg-slate-50`} />
                  <td className={`${borderCls} px-2 py-1.5`}>
                    <input
                      value={addForm.muatan}
                      inputMode="numeric"
                      placeholder="muatan"
                      onChange={(e) => setAddForm((f) => ({ ...f, muatan: e.target.value }))}
                      onKeyDown={(e) => e.key === 'Enter' && void submitAdd()}
                      className="w-full bg-transparent text-right text-[13px] tabular-nums outline-none"
                    />
                  </td>
                  <td className={`${borderCls} px-2 py-1.5`}>
                    <input
                      value={addForm.kosong}
                      inputMode="numeric"
                      placeholder="kosong"
                      onChange={(e) => setAddForm((f) => ({ ...f, kosong: e.target.value }))}
                      onKeyDown={(e) => e.key === 'Enter' && void submitAdd()}
                      className="w-full bg-transparent text-right text-[13px] tabular-nums outline-none"
                    />
                  </td>
                </tr>
              </tfoot>
            ) : (
              <tfoot>
                <tr>
                  <td colSpan={5} className={`${borderCls}`}>
                    <button
                      onClick={() => setAddOpen(true)}
                      className="w-full py-1.5 text-center text-[11px] font-medium text-slate-400 transition hover:bg-slate-50 hover:text-slate-600"
                    >
                      + tambah baris
                    </button>
                  </td>
                </tr>
              </tfoot>
            )
          }
        />
        <datalist id="tariff-golongan-options">
          {GOLONGAN_OPTIONS.map((g) => (
            <option key={g} value={g} />
          ))}
        </datalist>

        {/* Panel REGION: tarif lokal per wilayah; tarif external mengacu
            tarif trip asli pada master ( tabelBADAU ), bukan nomal flat. */}
        <GolonganSheet
          title="REGION"
          titleExtra={
            <select
              value={panelRegion?.id ?? ''}
              onChange={(e) => setPanelRegionId(e.target.value)}
              className="rounded border border-slate-200 bg-white px-1.5 py-1 text-[12px] font-semibold text-slate-600 outline-none hover:border-slate-300"
            >
              {regions.length === 0 && <option value="">–</option>}
              {regions.map((r) => (
                <option key={r.id} value={r.id}>
                  {r.code} — {r.name}
                </option>
              ))}
            </select>
          }
          rows={sortedRows}
          placeholdersExternal
          getLokal={() => {
            const reg = panelRegion
            if (!reg) return 0
            return regionTariffs[reg.id]?.lokal ?? 0
          }}
          commitLokal={(_row, v) => commitLokal(viewRegion, _row, v)}
          commitMuatan={CONSUME}
          commitKosong={CONSUME}
          onDelete={handleDelete}
        />
      </div>

      {/* Keterangan singkat */}
      <div className="rounded-xl border border-slate-200 bg-white px-4 py-3 text-[11px] text-slate-500 shadow-sm space-y-1">
        <p>
          <b className="text-slate-700">BADAU</b> — kolom muatan &amp; kosong adalah master tarif per golongan yang
          dipakai aplikasi saat menghitung tagihan trip. Kolom konfigurasi tarif terpusat (tarif flat eksternal)
          sudah dihapus.
        </p>
        <p>
          <b className="text-slate-700">REGION</b> — tariff lokal per wilayah dipakai tarif cadangan; angka
          "tarif muatan"/"tarif kosong" mengacu tabel BADAU.
        </p>
        <p>
          <b className="text-slate-700">internal</b> terkunci Rp 0 (kendaraan internal tidak pernah ditagih).
        </p>
      </div>
    </div>
  )
}
