{
  "name": "ionic-app-base",
  "version": "1.0.18",
  "author": "Ionic Framework",
  "homepage": "https://ionicframework.com/",
  "engines": {
    "node": ">=22.22.3 <23"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "dev": "ng serve",
    "status": "node scripts/dev-status.mjs",
    "cache:clean": "ng cache clean",
    "build": "ng build && node scripts/organize-build.mjs",
    "build:raw": "ng build",
    "ota:publish": "node scripts/publish-ota-git.mjs",
    "watch": "ng build --watch --configuration development",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "lint": "ng lint"
  },
  "private": true,
  "dependencies": {
    "@angular/core": "22.1.7",
    "@capacitor-community/sqlite": "^8.1.1",
    "@capacitor/app": "^8.1.1",
    "@capacitor/camera": "^8.2.5",
    "@capacitor/core": "^8.5.2",
    "@capacitor/device": "^8.0.3",
    "@capacitor/filesystem": "^8.1.4",
    "@capacitor/geolocation": "^8.2.3",
    "@capacitor/network": "^8.0.0",
    "bcryptjs": "^3.0.3",
    "cordova-plugin-file-opener2": "^4.0.0",
    "express": "^4.19.2",
    "lucide-react": "^1.47.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tesseract.js": "^7.0.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.2",
    "@angular/cli": "^22.2.2",
    "@angular/compiler": "22.1.7",
    "@angular/compiler-cli": "22.1.7",
    "@capacitor/android": "^8.5.1",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "8.5.2",
    "@capacitor/ios": "^8.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "angular-eslint": "22.0.0",
    "autoprefixer": "^10.6.1",
    "eslint": "^10.10.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^26.0.0",
    "postcss": "^8.5.28",
    "rxjs": "~7.8.0",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.61.0",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "esbuild": true,
    "lmdb": true,
    "msgpackr-extract": true,
    "tesseract.js": true,
    "@parcel/watcher": true,
    "sharp@0.32.6": true
  }
}
