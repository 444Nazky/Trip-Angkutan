# Salin file ini menjadi `.env.local` di folder yang sama, lalu isi nilainya.
#
#   cp supabase/functions/api/.env.example supabase/functions/api/.env.local
#
# File `.env.local` sudah masuk .gitignore — JANGAN di-commit (berisi secret).

# URL project Supabase (wajib)
SUPABASE_URL=https://bmiruktfruunegtbydyw.supabase.co

# Service role key Supabase (wajib)
# Ambil dari: Supabase Dashboard > Project Settings > API > service_role key
SUPABASE_SERVICE_ROLE_KEY=

# RAHASIA JWT — HARUS SAMA dengan secret yang dipakai di Supabase Edge Function.
# Kalau berbeda, token yang issued server cloud TIDAK akan valid di server
# intranet (dan sebaliknya) -> petugas tampak login success lalu langsung
# session expired. Ambil dari: supabase secrets list
JWT_SECRET=

# Kredensial admin dashboard (opsional, default: admin / admin123456)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Set "1" hanya untuk debugging lokal (melewati login admin).
# JANGAN di-set di PC yang bisa diakses jaringan lain.
# ADMIN_AUTH_DISABLED=

# Token untuk publish versi/OTA dari server lokal (opsional)
# PUBLISH_SECRET=
