# Required for production
JWT_SECRET=your-secure-random-secret-here

# Optional - defaults to admin/admin123
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Database path (optional)
DB_PATH=./data/trip.db

# Uploads directory (optional)
UPLOADS_DIR=./uploads

# Server port (optional) — 3000 adalah port yang dipakai mobile & dashboard
PORT=3000

# Origin browser yang diizinkan (pisahkan dengan koma).
# Untuk Wi-Fi lokal: mobile 5173, dashboard admin 8000, API 3000.
# Origin localhost/Capacitor sudah otomatis diizinkan oleh kode.
CORS_ORIGIN=http://192.168.1.124:5173,http://192.168.1.124:8000,http://192.168.1.124:3000
