# ============================================
# SUPABASE CONFIGURATION (REQUIRED)
# ============================================
# Get these from your Supabase project dashboard
# https://supabase.com/dashboard/project/YOUR_PROJECT_ID/settings/api

SUPABASE_URL=https://bmiruktfruunegtbydyw.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_KEY=your-service-role-key-here

# ============================================
# JWT SECRET (REQUIRED)
# ============================================
# Generate a secure random secret for JWT signing
# Example: openssl rand -base64 32
JWT_SECRET=your-secure-random-secret-here-minimum-32-characters

# ============================================
# ADMIN CREDENTIALS (Optional - generates on first run if not set)
# ============================================
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password-in-production

# ============================================
# SERVER CONFIGURATION
# ============================================
PORT=3000

# Allowed CORS origins (comma-separated)
# Default origins (localhost, capacitor, ionic) are always allowed
# CORS_ORIGIN=https://your-dashboard-domain.com,https://your-mobile-domain.com

# Enable admin access without token (for LAN/intranet only!)
# WARNING: Never enable this in production!
# ADMIN_AUTH_DISABLED=0

# ============================================
# FILE UPLOADS
# ============================================
UPLOADS_DIR=./uploads
