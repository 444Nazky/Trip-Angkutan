# Server API INTRANET (port 3000) - konfigurasi lokal PC kantor.
# File ini BERISI SECRET -> sudah masuk .gitignore, JANGAN di-commit.
#
# Backend sepenuhnya lokal: PostgreSQL (container `db`) + PostgREST
# (container `rest`) + berkas di disk. Tidak ada kredensial cloud,
# tidak ada panggilan keluar.

PORT=3000
HOST=0.0.0.0

# Alamat PostgREST lokal. docker-compose.yml menimpanya dengan
# http://rest:3000 (alam internal jaringan compose).
POSTGREST_URL=http://rest:3000

# Direktori penyimpanan berkas (foto trip, APK, bundel OTA).
STORAGE_DIR=/data/storage

# WAJIB. Tanpa ini server memakai secret bawaan yang tertulis di source,
# jadi siapa pun yang bisa membaca repo bisa membuat token admin sendiri.
JWT_SECRET=FUvW10zryDxTSapkQad5b1QsMRF9qs81fK4PnCmr

ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# IP LAN host (dipakai banner server intranet agar URL yang ditampilkan
# benar-benar bisa dibuka perangkat di jaringan, bukan IP container)
LAN_IP=10.187.220.110
ADMIN_AUTH_DISABLED=1
