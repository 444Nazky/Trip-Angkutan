{
  "compileOnSave": false,
  "compilerOptions": {
    "outDir": "./dist/out-tsc",
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "sourceMap": true,
    "declaration": false,
    "experimentalDecorators": true,
    "moduleResolution": "bundler",
    "importHelpers": true,
    "target": "es2022",
    "module": "es2020",
    "lib": [
      "es2022",
      "dom"
    ],
    "skipLibCheck": true,
    "useDefineForClassFields": false,
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "allowJs": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    "strictTemplates": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx"
  ],
  "exclude": [
    "node_modules",

    // ── Kode dashboard ADMIN yang ikut ter-merge ke repo MOBILE ini ──────────
    // Dua aplikasi npm berbeda tidak bisa berbagi satu manifest di root. Admin
    // sekarang punya package.json/tsconfig sendiri, dan kode yang tertinggal di
    // sini mengimpor API versi admin (getOk, ensureAdminSession, pingBaseUrl)
    // yang tidak ada di services/api.ts milik mobile → tsc gagal di file yang
    // tidak pernah dipakai aplikasi mobile.
    "src/pages/admin",
    "src/services/api.test.ts",
    "src/services/dermagas.ts",
    "src/services/geofences.ts",
    "src/services/geo.ts",
    "src/services/geo.test.ts",
    "src/services/locationDistance.ts",
    "src/services/regions.ts",
    "src/services/tariffs.ts",
    "src/services/theme.ts",
    "src/services/trips.ts",
    "src/services/xlsx.ts"
  ]
}
