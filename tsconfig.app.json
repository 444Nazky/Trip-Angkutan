/* Admin/React pages need @types/react to resolve alongside Angular. */
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./out-tsc/app", "skipLibCheck": true
  },
  "files": ["src/main.tsx"],
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx"]
}
